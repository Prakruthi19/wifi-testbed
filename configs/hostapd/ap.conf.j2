# Rendered by testbed/ap.py -- single-BSS AP for Modules 1 and 2.
interface={{ iface }}
{% if bridge is defined and bridge %}
# Home network: every AP is bridged into one network, so a device keeps its address.
bridge={{ bridge }}
{% endif %}
driver=nl80211
ctrl_interface={{ ctrl_dir }}
ctrl_interface_group=0

ssid={{ ssid }}
country_code={{ country_code }}
ieee80211d=1
hw_mode={{ hw_mode }}
channel={{ channel }}
ieee80211n=1
{% if ht_capab is defined and ht_capab %}
# 40 MHz channel: about twice the speed of 20 MHz
ht_capab={{ ht_capab }}
{% endif %}
wmm_enabled=1
beacon_int=100

{% if rrm is defined and rrm %}
# 802.11k: answer "which other APs of this network are near you?" (neighbor report)
rrm_neighbor_report=1
rrm_beacon_report=1
{% endif %}
{% if bss_transition is defined and bss_transition %}
# 802.11v: this AP may ask a device to move to another AP (BSS Transition Management)
bss_transition=1
{% endif %}
{% if ap_isolate is defined and ap_isolate %}
# Client isolation: devices on this AP cannot talk to each other (like a guest network)
ap_isolate=1
{% endif %}

{% if deny_macs %}
macaddr_acl=0
deny_mac_file={{ deny_mac_file }}
{% endif %}
{% if key_mgmt %}
wpa=2
wpa_key_mgmt={{ key_mgmt }}
rsn_pairwise=CCMP
ieee80211w={{ pmf }}
{% if "WPA-PSK" in key_mgmt.split() %}
wpa_passphrase={{ passphrase }}
{% endif %}
{% if "SAE" in key_mgmt.split() %}
sae_password={{ sae_password or passphrase }}
{% endif %}
{% if "WPA-EAP" in key_mgmt.split() %}
# 802.1X: hostapd's built-in EAP server stands in for a RADIUS server.
ieee8021x=1
eap_server=1
eap_user_file={{ eap_user_file }}
{% if eap_cert is defined and eap_cert %}
ca_cert={{ eap_cert.cert }}
server_cert={{ eap_cert.cert }}
private_key={{ eap_cert.key }}
{% endif %}
{% endif %}
{% else %}
# Open network
auth_algs=1
{% endif %}

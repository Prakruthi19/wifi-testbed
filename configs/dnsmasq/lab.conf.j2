# Rendered by testbed/network.py
# Runs only on lab interfaces so it never collides with systemd-resolved on 127.0.0.53.
# bind-dynamic tolerates hostapd bouncing the interface after dnsmasq starts.
bind-dynamic
except-interface=lo
no-resolv
no-hosts
domain={{ domain }}
pid-file={{ pid_file }}
log-facility={{ log_file }}
log-dhcp
# No "is this address free?" ping before each offer. dnsmasq waits up to 3 s per ping, one client
# at a time: in the first home-network run (2026-09-29) five devices asking together got their
# offers 3 s apart, the last ones after their DHCP client had given up. Every lab lease is
# fresh, so the check guards nothing here.
no-ping
log-queries

{% if dns %}
{% for name, ip in dns_records.items() %}
address=/{{ name }}/{{ ip }}
{% endfor %}
{% else %}
# DNS disabled (Module 2 "DNS broken" case)
port=0
{% endif %}

{% for net in subnets %}
interface={{ net.iface }}
{% if dhcp %}
dhcp-range=set:{{ net.tag }},{{ net.start }},{{ net.end }},255.255.255.0,5m
dhcp-option=tag:{{ net.tag }},option:router,{{ net.gateway }}
dhcp-option=tag:{{ net.tag }},option:dns-server,{{ net.gateway }}
{% endif %}
{% endfor %}
{% if dhcp %}
dhcp-leasefile={{ lease_file }}
dhcp-authoritative
{% else %}
# DHCP disabled (Module 2 "DHCP server down" case)
{% endif %}

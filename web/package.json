    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "private": true,
  "type": "module"
